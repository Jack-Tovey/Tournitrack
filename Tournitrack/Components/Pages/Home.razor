@page "/"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Tournitrack.Data.Models

@attribute [StreamRendering]

@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
@inject ILogger<Home> Logger

<PageTitle>Index</PageTitle>

<h1>Hello!</h1>

Welcome to Tournitrack, the only website/service you'll ever need for your tournament needs!.
<br/>
<br/>
<h2>Upcoming Tournaments</h2>

@if (isLoading)
{
    <div class="card my-3" role="status" aria-live="polite">
        <div class="card-body d-flex align-items-center gap-3">
            <span class="spinner-border text-primary" aria-hidden="true"></span>
            <span>Loading upcoming tournaments...</span>
        </div>
    </div>
}
else if (tournaments == null)
{
    <p>Failed to load tournaments. Please try again later.</p>
}
else if (tournaments.Count == 0)
{
    <p>No upcoming tournaments</p>
}
else
{
    <QuickGrid Class="table" Items="tournaments.AsQueryable()">
        <PropertyColumn Property="tournaments => tournaments.TournamentName" Title="Tournament Name"/>
        <PropertyColumn Property="tournaments => tournaments.Location" Title="Location"/>
        <PropertyColumn Property="tournaments => tournaments.TournamentDate.ToShortDateString()" Title="Date"/>
        <TemplateColumn>
            <a href="@($"TournamentInfo?TournamentID={context.ID}")">View Details</a>
        </TemplateColumn>
    </QuickGrid>
}

<SurveyPrompt Title="How is Tournitrack?" />

@code {
    private List<Tournaments>? tournaments;
    private bool isLoading = true;
    private const int MaxRetryCount = 5;
    private const int RetryDelayMilliseconds = 2000;

    protected override async Task OnInitializedAsync() =>
        await LoadTournamentsWithRetryAsync();

    private async Task LoadTournamentsWithRetryAsync()
    {
        for (var attempt = 1; attempt <= MaxRetryCount; attempt++)
        {
            try
            {
                using var context = DbFactory.CreateDbContext();
                var sql = "SELECT * FROM Tournaments WHERE TournamentDate > @p0 ORDER BY TournamentDate";
                var currentDate = DateOnly.FromDateTime(DateTime.Now);

                tournaments = await context.Tournaments
                    .FromSqlRaw(sql, currentDate)
                    .ToListAsync();

                break;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load upcoming tournaments (attempt {Attempt}).", attempt);

                if (attempt == MaxRetryCount)
                    break;

                await Task.Delay(RetryDelayMilliseconds);
            }
        }

        isLoading = false;
    }
}
