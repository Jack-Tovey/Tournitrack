@page "/UpdateMatch/Post"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore;
@using Tournitrack.Data
@using Tournitrack.Data.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory;
@inject NavigationManager NavigationManager;
@inject AuthenticationStateProvider AuthenticationStateProvider;
<h3>UpdateMatchPost</h3>

<AuthorizeView>
    <Authorized>
        @if (!isAuthorized)
        {
            @* Display unauthorized message if the user is not authorized *@
            <h1>YOU'RE NOT AUTHORISED TO VIEW THIS PAGE!</h1>
            <h3>Redirecting to Home page in 5s, if this does not happen automatically please click the following link.</h3>
            <a href="/">Home</a>
        }
        else
        {
            @* Display the form to update match details if the user is authorized *@
            <div class="row">
                <div class="col-md-6">
                    <h1>Home Team Sheet</h1>
                    <div class="modal-header">
                        <h3 class="modal-title">Edit Home Details</h3>
                    </div>
                    <div class="modal-body">
                        <h3>Players</h3>
                        @* Loop to display dropdowns for selecting home team players *@
                        @for (int i = 0; i <= 15; i++)
                        {
                            int index = i;
                            <select class="form-control" @bind="Input.PlayerIDsHome[index]">
                                <option value=0>NO PLAYER</option>
                                @foreach (Players Player in HomeTeamPlayers)
                                {
                                    <option value=@Player.ID @key="Player.ID">@Player.LastName, @Player.FirstName #@Player.shirtNumber</option>
                                }
                            </select>
                        }
                        <h3>Bench Staff</h3>
                        <h6>Coach</h6>
                        @* Input for home team coach name *@
                        <input class="form-control" type="text"
                               placeholder="Coach Name (Last, First)" @bind="Input.HomeCoachName" />
                        <h6>Manager</h6>
                        @* Input for home team manager name *@
                        <input class="form-control" type="text"
                               placeholder="Manager Name (Last, First)" @bind="Input.HomeManagerName" />
                        <h6>Medical Officer</h6>
                        @* Input for home team medical officer name *@
                        <input class="form-control" type="text"
                               placeholder="Medical officer Name (Last, First)" @bind="Input.HomeMedicalName" />
                        <br />

                        @* Button to save home team details *@
                        <button class="btn btn-primary" @onclick="SaveHome">Save</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <h1>Away Team Sheet</h1>
                    <div class="modal-header">
                        <h3 class="modal-title">Edit Away Details</h3>
                    </div>
                    <div class="modal-body">
                        <h3>Players</h3>
                        @* Loop to display dropdowns for selecting away team players *@
                        @for (int i = 0; i <= 15; i++)
                        {
                            int index = i;
                            <select class="form-control" @bind="Input.PlayerIDsAway[index]">
                                <option value=0>NO PLAYER</option>
                                @foreach (Players Player in AwayTeamPlayers)
                                {
                                    <option value=@Player.ID @key="Player.ID">@Player.LastName, @Player.FirstName #@Player.shirtNumber</option>
                                }
                            </select>
                        }
                        <h3>Bench Staff</h3>
                        <h6>Coach</h6>
                        @* Input for away team coach name *@
                        <input class="form-control" type="text"
                               placeholder="Coach Name (Last, First)" @bind="Input.AwayCoachName" />
                        <h6>Manager</h6>
                        @* Input for away team manager name *@
                        <input class="form-control" type="text"
                               placeholder="Manager Name (Last, First)" @bind="Input.AwayManagerName" />
                        <h6>Medical Officer</h6>
                        @* Input for away team medical officer name *@
                        <input class="form-control" type="text"
                               placeholder="Medical officer Name (Last, First)" @bind="Input.AwayMedicalName" />
                        <br />

                        @* Button to save away team details *@
                        <button class="btn btn-primary" @onclick="SaveAway">Save</button>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <h3>Home Team Goals</h3>
                    @for (int i = 0; i < Input.HomeGoals.Count; i++)
                    {
                        <h5>Goal @(i+1)</h5>
                        <div class="goal-entry">
                            <h6>Scorer</h6>
                            <select class="form-control" @bind="Input.HomeGoals[i].PlayerID">
                                <option value=0>NO PLAYER</option>
                                @foreach (Players Player in HomeTeamPlayers)
                                {
                                    <option value=@Player.ID @key="Player.ID">@Player.LastName, @Player.FirstName #@Player.shirtNumber</option>
                                }
                            </select>
                            <h6>Goal Type</h6>
                            <select class="form-control" @bind="Input.HomeGoals[i].GoalType">
                                <option value="FG">Field Goal</option>
                                <option value="PC">Penalty Corner</option>
                                <option value="PS">Penalty Stroke</option>
                            </select>
                            <h6> Goal Time</h6>
                            <input class="form-control" type="number" placeholder="Minute" @bind="Input.HomeGoals[i].MatchMinute"/>
                        </div>
                    }
                    <button class="btn btn-secondary" @onclick="AddHomeGoal">Add Goal</button>
                </div>
                <div class="col-md-6">
                    <h3>Away Team Goals</h3>
                    @for (int i = 0; i < Input.AwayGoals.Count; i++)
                    {
                        <h5>Goal @(i+1)</h5>
                        <div class="goal-entry">
                            <h6>Scorer</h6>
                            <select class="form-control" @bind="Input.AwayGoals[i].PlayerID">
                                <option value=0>NO PLAYER</option>
                                @foreach (Players Player in AwayTeamPlayers)
                                {
                                    <option value=@Player.ID @key="Player.ID">@Player.LastName, @Player.FirstName #@Player.shirtNumber</option>
                                }
                            </select>
                            <h6>Goal Type</h6>
                            <select class="form-control" @bind="Input.AwayGoals[i].GoalType">
                                <option value="FG">Field Goal</option>
                                <option value="PC">Penalty Corner</option>
                                <option value="PS">Penalty Stroke</option>
                            </select>
                            <h6>Goal Time</h6>
                            <input class="form-control" type="number" placeholder="Minute" @bind="Input.AwayGoals[i].MatchMinute"/>
                        </div>
                    }
                    <button class="btn btn-secondary" @onclick="AddAwayGoal">Add Goal</button>
                </div>
            </div>
        }
        <h3>Mark Game as Complete</h3>
        <h7>This cannot be undone</h7>
        @* Button to mark the game as complete *@
        <button class="btn btn-primary" @onclick="GameComplete">COMPLETE</button>
    </Authorized>
    <NotAuthorized>
        @* Display unauthorized message if the user is not authorized *@
        <h1>YOU'RE NOT AUTHORISED TO VIEW THIS PAGE!</h1>
        <h3>Redirecting to Home page in 5s, if this does not happen automatically please click the following link.</h3>
        <a href="/">Home</a>
    </NotAuthorized>
</AuthorizeView>



@code {
    private bool isAuthorized = true; // Flag to check if user is authorised to view page
    private List<Players> HomeTeamPlayers = new(); // List to store home team players
    private List<Players> AwayTeamPlayers = new(); // List to store away team players

    private async Task RedirectAfterDelay()
    {
        await Task.Delay(5000);
        NavigationManager.NavigateTo("/"); // Redirect to home page after 5 seconds
    }

    [SupplyParameterFromQuery] private int ID { get; set; } // Match ID from URL
    public InputModel Input { get; set; } = new InputModel(); // Input model to bind to input form data

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (!user.IsInRole("Administrator") && !user.IsInRole("TournamentDirector") && !user.IsInRole("Official") && !user.IsInRole("OfficialManager"))
        {
            isAuthorized = false;
            StateHasChanged(); // Trigger a re-render to show the unauthorized message
            _ = RedirectAfterDelay();
        }
        else
        {
            // Get the match details
            using var context = DbFactory.CreateDbContext();
            string sql = "SELECT * FROM Matches WHERE ID = @p0";
            Matches match = context.Matches.FromSqlRaw(sql, ID).FirstOrDefault();

            HomeTeamPlayers = GetPlayersForHomeTeamClub(ID);
            AwayTeamPlayers = GetPlayersForAwayTeamClub(ID);

            GetHomeTeamSheet();
            GetAwayTeamSheet();
            GetHomeGoals();
            GetAwayGoals();
        }
    }

    public class InputModel
    {
        public int[] PlayerIDsHome { get; set; } = new int[16]; // Array to store home team player IDs
        public int[] PlayerIDsAway { get; set; } = new int[16]; // Array to store away team player IDs
        public string HomeCoachName { get; set; }
        public string HomeManagerName { get; set; }
        public string HomeMedicalName { get; set; }
        public List<PlayerGoals> HomeGoals { get; set; } = new List<PlayerGoals>(); // List to store home team goals

        public string AwayCoachName { get; set; }
        public string AwayManagerName { get; set; }
        public string AwayMedicalName { get; set; }
        public List<PlayerGoals> AwayGoals { get; set; } = new List<PlayerGoals>(); // List to store away team goals
    }

    public List<Players> GetPlayersForHomeTeamClub(int matchID)
    {
        using var context = DbFactory.CreateDbContext();
        string sql = "SELECT Players.* FROM Players, Teams, Matches WHERE Matches.ID = @p0 AND Matches.TeamIDHome = Teams.ID AND Teams.ClubID = Players.ClubID ORDER BY Players.LastName";
        return context.Players.FromSqlRaw(sql, matchID).ToList();
    }

    public List<Players> GetPlayersForAwayTeamClub(int matchID)
    {
        using var context = DbFactory.CreateDbContext();
        string sql = "SELECT Players.* FROM Players, Teams, Matches WHERE Matches.ID = @p0 AND Matches.TeamIDAway = Teams.ID AND Teams.ClubID = Players.ClubID ORDER BY Players.LastName";
        return context.Players.FromSqlRaw(sql, matchID).ToList();
    }

    public void GetHomeTeamSheet()
    {
        using var context = DbFactory.CreateDbContext();
        // Get the Home team sheet details
        string sql = @"
            SELECT Players.*
            FROM Players, TeamSheetPlayers, MatchTeamSheet
            WHERE Players.ID = TeamSheetPlayers.PlayerID
            AND TeamSheetPlayers.TeamSheetID = MatchTeamSheet.ID
            AND MatchTeamSheet.MatchID = @p0
            AND MatchTeamSheet.TeamID = (SELECT TeamIDHome FROM Matches WHERE ID = @p0)";
        Players[] teamsheet = context.Players.FromSqlRaw(sql, ID).ToArray();
        if (teamsheet != null)
        {
            int i = 0;
            foreach (Players p in teamsheet)
            {
                Input.PlayerIDsHome[i] = p.ID;
                i++;
            }

            // Get home team staff details
            sql = "SELECT * FROM MatchTeamSheet WHERE MatchID = @p0 AND TeamID = (SELECT TeamIDHome FROM Matches WHERE ID = @p0)";
            MatchTeamSheet staffSheet = context.MatchTeamSheet.FromSqlRaw(sql, ID).FirstOrDefault();
            Input.HomeCoachName = staffSheet?.CoachName ?? string.Empty;
            Input.HomeManagerName = staffSheet?.ManagerName ?? string.Empty;
            Input.HomeMedicalName = staffSheet?.MedicalName ?? string.Empty;
        }
        else
        {
            for (int i = 0; i <= 15; i++)
            {
                Input.PlayerIDsHome[i] = 0;
            }
        }
    }

    public void SaveHome()
    {
        using var context = DbFactory.CreateDbContext();
        string sql = @"
        SELECT *
        FROM MatchTeamSheet
        WHERE MatchID = @p0
        AND TeamID = (SELECT TeamIDHome FROM Matches WHERE ID = @p0)";
        MatchTeamSheet teamsheet = context.MatchTeamSheet.FromSqlRaw(sql, ID).FirstOrDefault();
        int teamSheetID;

        if (teamsheet == null)
        {
            // Insert new team sheet record
            sql = @"
            INSERT INTO MatchTeamSheet (MatchID, TeamID, CoachName, ManagerName, MedicalName)
            VALUES (@p0, (SELECT TeamIDHome FROM Matches WHERE ID = @p0), @p1, @p2, @p3)";
            context.Database.ExecuteSqlRaw(sql, ID, Input.HomeCoachName, Input.HomeManagerName, Input.HomeMedicalName);

            sql = "SELECT ID FROM MatchTeamSheet WHERE MatchID = @p0 AND TeamID = (SELECT TeamIDHome FROM Matches WHERE ID = @p0)";
            teamSheetID = context.MatchTeamSheet.FromSqlRaw(sql, ID).Select(m => m.ID).FirstOrDefault();

            for (int i = 0; i < Input.PlayerIDsHome.Length; i++)
            {
                sql = "INSERT INTO TeamSheetPlayers (TeamSheetID, PlayerID) VALUES (@p0, @p1)";
                context.Database.ExecuteSqlRaw(sql, teamSheetID, Input.PlayerIDsHome[i]);
            }
        }
        else
        {
            teamSheetID = teamsheet.ID;

            // Update existing team sheet record
            sql = @"
            UPDATE MatchTeamSheet
            SET CoachName = @p1, ManagerName = @p2, MedicalName = @p3
            WHERE MatchID = @p0 AND TeamID = (SELECT TeamIDHome FROM Matches WHERE ID = @p0)";
            context.Database.ExecuteSqlRaw(sql, ID, Input.HomeCoachName, Input.HomeManagerName, Input.HomeMedicalName);

            sql = "DELETE FROM TeamSheetPlayers WHERE TeamSheetID = @p0";
            context.Database.ExecuteSqlRaw(sql, teamSheetID);

            for (int i = 0; i < Input.PlayerIDsHome.Length; i++)
            {
                sql = "INSERT INTO TeamSheetPlayers (TeamSheetID, PlayerID) VALUES (@p0, @p1)";
                context.Database.ExecuteSqlRaw(sql, teamSheetID, Input.PlayerIDsHome[i]);
            }
        }

        sql = "UPDATE Matches SET HomeTeamSheetID = @p0 WHERE ID = @p1";
        context.Database.ExecuteSqlRaw(sql, teamSheetID, ID);

        // Update the match details
        context.Database.ExecuteSqlRaw("DELETE FROM PlayerGoals WHERE MatchID = @p0 AND PlayerID IN (SELECT PlayerID FROM TeamSheetPlayers WHERE TeamSheetID = @p1)", ID, teamSheetID);
        // Insert goals into PlayerGoals table
        foreach (PlayerGoals goal in Input.HomeGoals)
        {
            sql = "INSERT INTO PlayerGoals (MatchID, PlayerID, GoalType, MatchMinute) VALUES (@p0, @p1, @p2, @p3)";
            context.Database.ExecuteSqlRaw(sql, ID, goal.PlayerID, goal.GoalType, goal.MatchMinute);
        }
    }

    public void GetAwayTeamSheet()
    {
        using var context = DbFactory.CreateDbContext();
        // Get the Away team sheet details
        string sql = @"
            SELECT Players.*
            FROM Players, TeamSheetPlayers, MatchTeamSheet
            WHERE Players.ID = TeamSheetPlayers.PlayerID
            AND TeamSheetPlayers.TeamSheetID = MatchTeamSheet.ID
            AND MatchTeamSheet.MatchID = @p0
            AND MatchTeamSheet.TeamID = (SELECT TeamIDAway FROM Matches WHERE ID = @p0)";
        Players[] teamsheet = context.Players.FromSqlRaw(sql, ID).ToArray();
        if (teamsheet != null)
        {
            int i = 0;
            foreach (Players p in teamsheet)
            {
                Input.PlayerIDsAway[i] = p.ID;
                i++;
            }

            // Get away team staff details
            sql = "SELECT * FROM MatchTeamSheet WHERE MatchID = @p0 AND TeamID = (SELECT TeamIDAway FROM Matches WHERE ID = @p0)";
            MatchTeamSheet staffSheet = context.MatchTeamSheet.FromSqlRaw(sql, ID).FirstOrDefault();
            Input.AwayCoachName = staffSheet?.CoachName ?? string.Empty;
            Input.AwayManagerName = staffSheet?.ManagerName ?? string.Empty;
            Input.AwayMedicalName = staffSheet?.MedicalName ?? string.Empty;
        }
        else
        {
            for (int i = 0; i <= 15; i++)
            {
                Input.PlayerIDsAway[i] = 0;
            }
        }
    }

    public void SaveAway()
    {
        using var context = DbFactory.CreateDbContext();
        string sql = @"
        SELECT *
        FROM MatchTeamSheet
        WHERE MatchID = @p0
        AND TeamID = (SELECT TeamIDAway FROM Matches WHERE ID = @p0)";
        MatchTeamSheet teamsheet = context.MatchTeamSheet.FromSqlRaw(sql, ID).FirstOrDefault();
        int teamSheetID;

        if (teamsheet == null)
        {
            // Insert new team sheet record
            sql = @"
            INSERT INTO MatchTeamSheet (MatchID, TeamID, CoachName, ManagerName, MedicalName)
            VALUES (@p0, (SELECT TeamIDAway FROM Matches WHERE ID = @p0), @p1, @p2, @p3)";
            context.Database.ExecuteSqlRaw(sql, ID, Input.AwayCoachName, Input.AwayManagerName, Input.AwayMedicalName);

            sql = "SELECT ID FROM MatchTeamSheet WHERE MatchID = @p0 AND TeamID = (SELECT TeamIDAway FROM Matches WHERE ID = @p0)";
            teamSheetID = context.MatchTeamSheet.FromSqlRaw(sql, ID).Select(m => m.ID).FirstOrDefault();

            for (int i = 0; i < Input.PlayerIDsAway.Length; i++)
            {
                sql = "INSERT INTO TeamSheetPlayers (TeamSheetID, PlayerID) VALUES (@p0, @p1)";
                context.Database.ExecuteSqlRaw(sql, teamSheetID, Input.PlayerIDsAway[i]);
            }
        }
        else
        {
            teamSheetID = teamsheet.ID;

            // Update existing team sheet record
            sql = @"
            UPDATE MatchTeamSheet
            SET CoachName = @p1, ManagerName = @p2, MedicalName = @p3
            WHERE MatchID = @p0 AND TeamID = (SELECT TeamIDAway FROM Matches WHERE ID = @p0)";
            context.Database.ExecuteSqlRaw(sql, ID, Input.AwayCoachName, Input.AwayManagerName, Input.AwayMedicalName);

            sql = "DELETE FROM TeamSheetPlayers WHERE TeamSheetID = @p0";
            context.Database.ExecuteSqlRaw(sql, teamSheetID);

            for (int i = 0; i < Input.PlayerIDsAway.Length; i++)
            {
                sql = "INSERT INTO TeamSheetPlayers (TeamSheetID, PlayerID) VALUES (@p0, @p1)";
                context.Database.ExecuteSqlRaw(sql, teamSheetID, Input.PlayerIDsAway[i]);
            }
        }

        sql = "UPDATE Matches SET AwayTeamSheetID = @p0 WHERE ID = @p1";
        context.Database.ExecuteSqlRaw(sql, teamSheetID, ID);

        // Update the match details
        context.Database.ExecuteSqlRaw("DELETE FROM PlayerGoals WHERE MatchID = @p0 AND PlayerID IN (SELECT PlayerID FROM TeamSheetPlayers WHERE TeamSheetID = @p1)", ID, teamSheetID);
        // Insert goals into PlayerGoals table
        foreach (PlayerGoals goal in Input.AwayGoals)
        {
            sql = "INSERT INTO PlayerGoals (MatchID, PlayerID, GoalType, MatchMinute) VALUES (@p0, @p1, @p2, @p3)";
            context.Database.ExecuteSqlRaw(sql, ID, goal.PlayerID, goal.GoalType, goal.MatchMinute);
        }
    }

    public void GetHomeGoals()
    {
        using var context = DbFactory.CreateDbContext();
        string sql = "SELECT * FROM PlayerGoals WHERE MatchID = @p0 AND PlayerID IN (SELECT PlayerID FROM TeamSheetPlayers WHERE TeamSheetID = (SELECT HomeTeamSheetID FROM Matches WHERE ID = @p0))";
        Input.HomeGoals = context.PlayerGoals.FromSqlRaw(sql, ID).ToList();
    }

    public void GetAwayGoals()
    {
        using var context = DbFactory.CreateDbContext();
        string sql = "SELECT * FROM PlayerGoals WHERE MatchID = @p0 AND PlayerID IN (SELECT PlayerID FROM TeamSheetPlayers WHERE TeamSheetID = (SELECT AwayTeamSheetID FROM Matches WHERE ID = @p0))";
        Input.AwayGoals = context.PlayerGoals.FromSqlRaw(sql, ID).ToList();
    }

    private void AddHomeGoal()
    {
        Input.HomeGoals.Add(new PlayerGoals());
    }

    private void AddAwayGoal()
    {
        Input.AwayGoals.Add(new PlayerGoals());
    }

    public void GameComplete()
    {
        // Mark the game as complete and redirect to home page
        using var context = DbFactory.CreateDbContext();
        string sql = "UPDATE Matches SET MatchComplete = 1 WHERE ID = @p0";
        context.Database.ExecuteSqlRaw(sql, ID);
        NavigationManager.NavigateTo("/");
    }
}
