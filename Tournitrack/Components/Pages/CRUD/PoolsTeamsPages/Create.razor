        @page "/poolsteams/create"
        @using Microsoft.EntityFrameworkCore
        @using Tournitrack.Data.Models
        @inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
        @inject NavigationManager NavigationManager

        <PageTitle>Create</PageTitle>

        <h1>Create</h1>

        <h2>PoolsTeams</h2>
        <hr />
        <div class="row">
            <div class="col-md-4">
                <!-- EditForm for creating a new PoolsTeams entry -->
                <EditForm method="post" Model="PoolsTeams" OnValidSubmit="AddPoolsTeams" FormName="create" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />
                    <div class="mb-3">
                        <label for="poolid" class="form-label">PoolID:</label>
                        <InputNumber id="poolid" @bind-Value="PoolsTeams.PoolID" class="form-control" />
                        <ValidationMessage For="() => PoolsTeams.PoolID" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="teamid" class="form-label">TeamID:</label>
                        <!-- Dropdown for selecting a team, grouped by club -->
                        <select id="teamidhome" @bind="PoolsTeams.TeamID" class="form-control">
                            <option value="">Select Team</option>
                            @foreach (Clubs club in Clubs)
                            {
                                <optgroup label="@club.Name">
                                    @foreach (Teams team in Teams.Where(t => t.ClubID == club.ID))
                                    {
                                        <option value="@team.ID">@team.TeamName</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <ValidationMessage For="() => PoolsTeams.TeamID" class="text-danger" />
                    </div>
                    <button type="submit" class="btn btn-primary">Create</button>
                </EditForm>
            </div>
        </div>

        <div>
            <a href="/poolsteams">Back to List</a>
        </div>

        @code {
            [SupplyParameterFromForm]
            private PoolsTeams PoolsTeams { get; set; } = new();
            private List<Teams> Teams { get; set; } = new();
            private List<Clubs> Clubs { get; set; } = new();

            // Method to initialize the component and load team and club details
            protected override async Task OnInitializedAsync()
            {
                using (var context = DbFactory.CreateDbContext())
                {
                    // SQL query to get team details
                    string teamsSql = "SELECT * FROM Teams";
                    Teams = await context.Teams.FromSqlRaw(teamsSql).ToListAsync();

                    // SQL query to get club details
                    string clubsSql = "SELECT * FROM Clubs";
                    Clubs = await context.Clubs.FromSqlRaw(clubsSql).ToListAsync();
                }
            }

            // Method to add a new PoolsTeams entry to the database
            private async Task AddPoolsTeams()
            {
                using var context = DbFactory.CreateDbContext();
                // SQL query to insert a new PoolsTeams entry
                string insertSql = "INSERT INTO PoolTeams (PoolID, TeamID) VALUES (@p0, @p1)";
                await context.Database.ExecuteSqlRawAsync(insertSql, PoolsTeams.PoolID, PoolsTeams.TeamID);
                NavigationManager.NavigateTo("/poolsteams");
            }
        }
