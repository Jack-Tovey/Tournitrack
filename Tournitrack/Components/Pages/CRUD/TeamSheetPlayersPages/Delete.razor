@page "/teamsheetplayers/delete"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Tournitrack.Data.Models
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>TeamSheetPlayers</h2>
    <hr />
    @if (teamsheetplayers is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">TeamSheetID</dt>
            <dd class="col-sm-10">@teamsheetplayers.TeamSheetID</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">PlayerID</dt>
            <dd class="col-sm-10">@teamsheetplayers.PlayerID - @player.shirtNumber - @player.LastName, @player.FirstName</dd>
        </dl>
        <!-- Button for deleting a TeamSheetPlayers entry -->
        <EditForm method="post" Model="teamsheetplayers" OnValidSubmit="DeleteTeamSheetPlayers" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(teamsheetplayers is null)">Delete</button> |
            <a href="/teamsheetplayers">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private TeamSheetPlayers? teamsheetplayers;
    private Players? player = new();

    [SupplyParameterFromQuery]
    private int ID { get; set; }

    // Method to initialize the component and load the TeamSheetPlayers entry to be deleted
    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        // SQL query to get the TeamSheetPlayers entry by ID
        teamsheetplayers = await context.TeamSheetPlayers.FromSqlRaw("SELECT * FROM TeamSheetPlayers WHERE ID = @p0", ID).FirstOrDefaultAsync();

        if (teamsheetplayers is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            // SQL query to get the player name and number by PlayerID
            player = await context.Players.FromSqlRaw("SELECT * FROM Players WHERE ID = @p0", teamsheetplayers.PlayerID).FirstOrDefaultAsync();
        }
    }

    // Method to delete the TeamSheetPlayers entry from the database
    private async Task DeleteTeamSheetPlayers()
    {
        using var context = DbFactory.CreateDbContext();
        // SQL query to delete the TeamSheetPlayers entry by ID
        await context.Database.ExecuteSqlRawAsync("DELETE FROM TeamSheetPlayers WHERE ID = @p0", teamsheetplayers!.ID);
        // Navigate back to the list page after deleting the entry
        NavigationManager.NavigateTo("/teamsheetplayers");
    }
}
