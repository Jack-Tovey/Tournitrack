@page "/teamsheetplayers"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Tournitrack.Data.Models
@using Tournitrack.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="teamsheetplayers/create">Create New</a>
</p>

<!-- QuickGrid to display the list of TeamSheetPlayers -->
<QuickGrid Class="table" Items="teamSheetPlayers.AsQueryable()">
    <PropertyColumn Property="teamsheetplayers => teamsheetplayers.TeamSheetID" />
    <PropertyColumn Property="teamsheetplayers => teamsheetplayers.PlayerID" />

    <TemplateColumn Context="teamsheetplayers">
        <a href="@($"teamsheetplayers/edit?id={teamsheetplayers.ID}")">Edit</a> |
        <a href="@($"teamsheetplayers/details?id={teamsheetplayers.ID}")">Details</a> |
        <a href="@($"teamsheetplayers/delete?id={teamsheetplayers.ID}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;
    private List<TeamSheetPlayers> teamSheetPlayers = new();

    // Method to initialize the component and load the list of TeamSheetPlayers
    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        // SQL query to get the list of TeamSheetPlayers
        string sql = "SELECT * FROM TeamSheetPlayers";
        teamSheetPlayers = await context.TeamSheetPlayers.FromSqlRaw(sql).ToListAsync();
    }

    // Dispose the DbContext when the component is disposed
    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}