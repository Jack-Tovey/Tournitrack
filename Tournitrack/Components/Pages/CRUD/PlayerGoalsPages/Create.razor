@page "/playergoals/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Tournitrack.Data.Models
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>PlayerGoals</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <!-- EditForm for creating a new PlayerGoals entry -->
        <EditForm method="post" Model="PlayerGoals" OnValidSubmit="AddPlayerGoals" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <label for="playerid" class="form-label">PlayerID:</label>
                <!-- Dropdown for selecting a player, grouped by club -->
                <select id="playerid" @bind="PlayerGoals.PlayerID" class="form-control">
                    <option value="">Select Player</option>
                    @foreach (Clubs club in Clubs)
                    {
                        <optgroup label="@club.Name">
                            @foreach (Players player in Players.Where(p => p.ClubID == club.ID))
                            {
                                <option value="@player.ID">@player.LastName, @player.FirstName</option>
                            }
                        </optgroup>
                    }
                </select>
                <ValidationMessage For="() => PlayerGoals.PlayerID" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="matchid" class="form-label">MatchID:</label>
                <InputNumber id="matchid" @bind-Value="PlayerGoals.MatchID" class="form-control" />
                <ValidationMessage For="() => PlayerGoals.MatchID" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="goaltype" class="form-label">GoalType:</label>
                <!-- Dropdown for selecting a goal type -->
                <select id="goaltype" @bind="PlayerGoals.GoalType" class="form-control">
                    <option value="">Select Goal Type</option>
                    <option value="FG">Field Goal</option>
                    <option value="PC">Penalty Corner</option>
                    <option value="PS">Penalty Stroke</option>
                </select>
                <ValidationMessage For="() => PlayerGoals.GoalType" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="matchminute" class="form-label">MatchMinute:</label>
                <InputNumber id="matchminute" @bind-Value="PlayerGoals.MatchMinute" class="form-control" />
                <ValidationMessage For="() => PlayerGoals.MatchMinute" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/playergoals">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private PlayerGoals PlayerGoals { get; set; } = new(); // Model for PlayerGoals
    private List<Players> Players { get; set; } = new(); // List of players for the dropdown
    private List<Clubs> Clubs { get; set; } = new(); // List of clubs for the dropdown

    // Method to initialize the component and load player and club details
    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        // SQL query to get player details
        string sql = "SELECT * FROM Players";
        Players = await context.Players.FromSqlRaw(sql).ToListAsync();

        // SQL query to get club details
        sql = "SELECT * FROM Clubs";
        Clubs = await context.Clubs.FromSqlRaw(sql).ToListAsync();
    }

    // Method to add a new PlayerGoals entry to the database
    private async Task AddPlayerGoals()
    {
        using var context = DbFactory.CreateDbContext();
        // SQL query to insert a new PlayerGoals entry
        string sql = "INSERT INTO PlayerGoals (PlayerID, MatchID, GoalType, MatchMinute) VALUES (@p0, @p1, @p2, @p3)";
        await context.Database.ExecuteSqlRawAsync(sql, PlayerGoals.PlayerID, PlayerGoals.MatchID, PlayerGoals.GoalType, PlayerGoals.MatchMinute);
        // Navigate back to the list page after creating the entry
        NavigationManager.NavigateTo("/playergoals");
    }
}
