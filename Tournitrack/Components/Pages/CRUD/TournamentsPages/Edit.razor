@page "/tournaments/edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Tournitrack.Data.Models
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Tournaments</h2>
<hr />
@if (Tournaments is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <!-- EditForm for updating a Tournaments entry -->
            <EditForm method="post" Model="Tournaments" OnValidSubmit="UpdateTournaments" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary />
                <input type="hidden" name="Tournaments.ID" value="@Tournaments.ID" />
                <div class="mb-3">
                    <label for="tournamentname" class="form-label">TournamentName:</label>
                    <InputText id="tournamentname" @bind-Value="Tournaments.TournamentName" class="form-control" />
                    <ValidationMessage For="() => Tournaments.TournamentName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location:</label>
                    <InputText id="location" @bind-Value="Tournaments.Location" class="form-control" />
                    <ValidationMessage For="() => Tournaments.Location" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="tournamentDate" class="form-label">Date:</label>
                    <InputDate id="tournamentDate" @bind-Value="Tournaments.TournamentDate" class="form-control" />
                    <ValidationMessage For="() => Tournaments.TournamentDate" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/tournaments">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int ID { get; set; }

    [SupplyParameterFromForm]
    private Tournaments? Tournaments { get; set; }

    // Method to initialize the component and load the Tournaments entry to be edited
    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        // SQL query to get the Tournaments entry by ID
        string sql = "SELECT * FROM Tournaments WHERE ID = @p0";
        Tournaments = await context.Tournaments.FromSqlRaw(sql, ID).FirstOrDefaultAsync();

        if (Tournaments is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // Method to update the Tournaments entry in the database
    private async Task UpdateTournaments()
    {
        using var context = DbFactory.CreateDbContext();
        // SQL query to update the Tournaments entry
        string sql = "UPDATE Tournaments SET TournamentName = @p0, Location = @p1, TournamentDate = @p2 WHERE ID = @p3";
        await context.Database.ExecuteSqlRawAsync(sql, Tournaments!.TournamentName, Tournaments.Location, Tournaments.TournamentDate, Tournaments.ID);

        // Navigate back to the list page after updating the entry
        NavigationManager.NavigateTo("/tournaments");
    }
}



