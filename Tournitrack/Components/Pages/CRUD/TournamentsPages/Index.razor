@page "/tournaments"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Tournitrack.Data.Models
@using Tournitrack.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="tournaments/create">Create New</a>
</p>

<!-- QuickGrid to display the list of Tournaments -->
<QuickGrid Class="table" Items="tournaments.AsQueryable()">
    <PropertyColumn Property="tournaments => tournaments.ID"/>
    <PropertyColumn Property="tournaments => tournaments.TournamentName"/>
    <PropertyColumn Property="tournaments => tournaments.Location"/>
    <PropertyColumn Property="tournaments => tournaments.TournamentDate.ToShortDateString()" Title="Date"></PropertyColumn>

    <TemplateColumn Context="tournaments">
        <a href="@($"tournaments/edit?id={tournaments.ID}")">Edit</a> |
        <a href="@($"tournaments/details?id={tournaments.ID}")">Details</a> |
        <a href="@($"tournaments/delete?id={tournaments.ID}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;
    private List<Tournaments> tournaments = new();

    // Method to initialize the component and load the list of Tournaments
    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        // SQL query to get the list of Tournaments
        string sql = "SELECT * FROM Tournaments";
        tournaments = await context.Tournaments.FromSqlRaw(sql).ToListAsync();
    }

    // Dispose the DbContext when the component is disposed
    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}