@page "/tournaments/delete"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Tournitrack.Data.Models
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Tournaments</h2>
    <hr />
    @if (tournaments is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">TournamentName</dt>
            <dd class="col-sm-10">@tournaments.TournamentName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Location</dt>
            <dd class="col-sm-10">@tournaments.Location</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">TournamentDate</dt>
            <dd class="col-sm-10">@tournaments.TournamentDate</dd>
        </dl>
        <!-- Button for deleting a Tournaments entry -->
        <EditForm method="post" Model="tournaments" OnValidSubmit="DeleteTournaments" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(tournaments is null)">Delete</button> |
            <a href="/tournaments">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Tournaments? tournaments;

    [SupplyParameterFromQuery]
    private int ID { get; set; }

    // Method to initialize the component and load the Tournaments entry to be deleted
    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        // SQL query to get the Tournaments entry by ID
        string sql = "SELECT * FROM Tournaments WHERE ID = @p0";
        tournaments = await context.Tournaments.FromSqlRaw(sql, ID).FirstOrDefaultAsync();

        if (tournaments is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // Method to delete the Tournaments entry from the database
    private async Task DeleteTournaments()
    {
        using var context = DbFactory.CreateDbContext();
        // SQL query to delete the Tournaments entry by ID
        string sql = "DELETE FROM Tournaments WHERE ID = @p0";
        await context.Database.ExecuteSqlRawAsync(sql, tournaments!.ID);
        // Navigate back to the list page after deleting the entry
        NavigationManager.NavigateTo("/tournaments");
    }
}
