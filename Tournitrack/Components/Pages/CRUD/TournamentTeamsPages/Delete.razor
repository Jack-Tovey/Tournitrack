@page "/tournamentteams/delete"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Tournitrack.Data.Models
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>TournamentTeams</h2>
    <hr />
    @if (tournamentteams is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">TournamentID</dt>
            <dd class="col-sm-10">@tournamentteams.TournamentID</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">TeamID</dt>
            <dd class="col-sm-10">@tournamentteams.TeamID - @teamName</dd>
        </dl>
        <!-- Button for deleting a TournamentTeams entry -->
        <EditForm method="post" Model="tournamentteams" OnValidSubmit="DeleteTournamentTeams" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(tournamentteams is null)">Delete</button> |
            <a href="/tournamentteams">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private TournamentTeams? tournamentteams;
    private string teamName = string.Empty;

    [SupplyParameterFromQuery]
    private int ID { get; set; }

    // Method to initialize the component and load the TournamentTeams entry to be deleted
    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        // SQL query to get the TournamentTeams entry by ID
        tournamentteams = await context.TournamentTeams.FromSqlRaw("SELECT * FROM TournamentTeams WHERE ID = @p0", ID).FirstOrDefaultAsync();

        if (tournamentteams is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            // SQL query to get the team name by TeamID
            teamName = await context.Teams.FromSqlRaw("SELECT TeamName FROM Teams WHERE ID = @p0", tournamentteams.TeamID).Select(t => t.TeamName).FirstOrDefaultAsync() ?? "Unknown";
        }
    }

    // Method to delete the TournamentTeams entry from the database
    private async Task DeleteTournamentTeams()
    {
        using var context = DbFactory.CreateDbContext();
        // SQL query to delete the TournamentTeams entry by ID
        string sql = "DELETE FROM TournamentTeams WHERE ID = @p0";
        await context.Database.ExecuteSqlRawAsync(sql, tournamentteams!.ID);
        // Navigate back to the list page after deleting the entry
        NavigationManager.NavigateTo("/tournamentteams");
    }
}



