@page "/officialavailabilities/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Tournitrack.Data
@using Tournitrack.Data.Models
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>OfficialAvailability</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="OfficialAvailability" OnValidSubmit="AddOfficialAvailability" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <!-- Dropdown to select a user with the "Official" role -->
                <label for="userid" class="form-label">User:</label>
                <InputSelect id="userid" @bind-Value="OfficialAvailability.UserID" class="form-control">
                    <option value="">Select a user</option>
                    @foreach (var user in officialUsers)
                    {
                        <option value="@user.Id">@user.UserName</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => OfficialAvailability.UserID" class="text-danger" />
            </div>
            <div class="mb-3">
                <!-- Input for the date -->
                <label for="date" class="form-label">Date:</label>
                <InputDate id="date" @bind-Value="OfficialAvailability.Date" class="form-control" />
                <ValidationMessage For="() => OfficialAvailability.Date" class="text-danger" />
            </div>
            <div class="mb-3">
                <!-- Checkbox for morning availability -->
                <label for="morning" class="form-label">Morning:</label>
                <InputCheckbox id="morning" @bind-Value="OfficialAvailability.Morning" class="form-check-input" />
                <ValidationMessage For="() => OfficialAvailability.Morning" class="text-danger" />
            </div>
            <div class="mb-3">
                <!-- Checkbox for afternoon availability -->
                <label for="afternoon" class="form-label">Afternoon:</label>
                <InputCheckbox id="afternoon" @bind-Value="OfficialAvailability.Afternoon" class="form-check-input" />
                <ValidationMessage For="() => OfficialAvailability.Afternoon" class="text-danger" />
            </div>
            <div class="mb-3">
                <!-- Checkbox for evening availability -->
                <label for="evening" class="form-label">Evening:</label>
                <InputCheckbox id="evening" @bind-Value="OfficialAvailability.Evening" class="form-check-input" />
                <ValidationMessage For="() => OfficialAvailability.Evening" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/officialavailabilities">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private OfficialAvailability OfficialAvailability { get; set; } = new();


    private List<ApplicationUser> officialUsers = new();

    // Method to initialize the component and load the list of users with the "Official" role
    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        //query to get users with the "Official" role
        string sql = @"
            SELECT AspNetUsers.*
            FROM AspNetUsers, AspNetUserRoles, AspNetRoles
            WHERE AspNetUsers.Id = AspNetUserRoles.UserId
            AND AspNetUserRoles.RoleId = AspNetRoles.Id
            AND AspNetRoles.Name = 'Official'";
        officialUsers = await context.Users.FromSqlRaw(sql).ToListAsync();
    }

    private async Task AddOfficialAvailability()
    {
        using var context = DbFactory.CreateDbContext();
        // Query to insert a new OfficialAvailability record
        string sql = "INSERT INTO OfficialAvailability (UserID, Date, Morning, Afternoon, Evening) VALUES (@p0, @p1, @p2, @p3, @p4)";
        await context.Database.ExecuteSqlRawAsync(sql, OfficialAvailability.UserID, OfficialAvailability.Date, OfficialAvailability.Morning, OfficialAvailability.Afternoon, OfficialAvailability.Evening);
        // Navigate back to the list of official availabilities
        NavigationManager.NavigateTo("/officialavailabilities");
    }
}