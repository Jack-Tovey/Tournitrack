@page "/clubs/delete"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Tournitrack.Data.Models
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Clubs</h2>
    <hr />
    @if (clubs is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@clubs.Name</dd>
        </dl>
        <EditForm method="post" Model="clubs" OnValidSubmit="DeleteClubs" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(clubs is null)">Delete</button> |
            <a href="/clubs">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Clubs? clubs;

    [SupplyParameterFromQuery]
    private int ID { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        string sql = "SELECT * FROM Clubs WHERE ID = @p0";
        clubs = await context.Clubs.FromSqlRaw(sql, ID).FirstOrDefaultAsync();

        if (clubs is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteClubs()
    {
        using var context = DbFactory.CreateDbContext();
        string sql = "DELETE FROM Teams WHERE ClubID = @p0";
        await context.Database.ExecuteSqlRawAsync(sql, ID);
        sql = "DELETE FROM Clubs WHERE ID = @p0";
        await context.Database.ExecuteSqlRawAsync(sql, ID);
        NavigationManager.NavigateTo("/clubs");
    }
}
