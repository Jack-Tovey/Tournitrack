@page "/clubs/edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Tournitrack.Data.Models
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Clubs</h2>
<hr />
@if (Clubs is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Clubs" OnValidSubmit="UpdateClubs" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Clubs.ID" value="@Clubs.ID" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Clubs.Name" class="form-control" />
                    <ValidationMessage For="() => Clubs.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="logo" class="form-label">Logo:</label>
                    <br/>
                    @if (Clubs.Logo != null && Clubs.Logo.Length > 0)
                    {
                        <img src="data:image/png;base64,@Convert.ToBase64String(Clubs.Logo)" alt="Logo" class="img-thumbnail" />
                    }
                    else
                    {
                        <p>No logo available, Database error or No logo uploaded. Use the upload logo below to upload one.</p>
                    }
                    <InputFile OnChange="HandleLogoUpload" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/clubs">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int ID { get; set; }

    [SupplyParameterFromForm]
    private Clubs? Clubs { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        string sql = "SELECT * FROM Clubs WHERE ID = @p0";
        Clubs ??= await context.Clubs.FromSqlRaw(sql, ID).FirstOrDefaultAsync();

        if (Clubs is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateClubs()
    {
        using var context = DbFactory.CreateDbContext();
        string sql = "UPDATE Clubs SET Name = @p0, Logo = @p1 WHERE ID = @p2";
        try
        {
            await context.Database.ExecuteSqlRawAsync(sql, Clubs!.Name, Clubs.Logo, Clubs.ID);
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ClubsExists(Clubs.ID))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/clubs");
    }

    private bool ClubsExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        string sql = "SELECT COUNT(*) FROM Clubs WHERE ID = @p0";
        return context.Database.ExecuteSqlRaw(sql, id) > 0;
    }

    private async Task HandleLogoUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream().CopyToAsync(stream);
            Clubs!.Logo = stream.ToArray();
        }
    }
}
