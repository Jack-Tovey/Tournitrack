@page "/pools/delete"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Tournitrack.Data.Models
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Pools</h2>
    <hr />
    @if (pools is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <!-- Display the details of the Pools record -->
        <dl class="row">
            <dt class="col-sm-2">TournamentID</dt>
            <dd class="col-sm-10">@pools.TournamentID</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">PoolNumber</dt>
            <dd class="col-sm-10">@pools.PoolNumber</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">PhaseNumber</dt>
            <dd class="col-sm-10">@pools.PhaseNumber</dd>
        </dl>
        <!-- Button to delete the Pools record -->
        <EditForm method="post" Model="pools" OnValidSubmit="DeletePools" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(pools is null)">Delete</button> |
            <a href="/pools">Back to List</a>
        </EditForm>
    }
</div>

@code {
    // The Pools record to be deleted
    private Pools? pools;

    // The ID of the Pools record to be deleted, supplied from the URL
    [SupplyParameterFromQuery]
    private int ID { get; set; }

    // Method to initialize the component and load the Pools record
    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        // Fetch the Pools record using SQL query
        pools = await context.Pools.FromSqlRaw("SELECT * FROM Pools WHERE ID = @p0", ID).FirstOrDefaultAsync();

        // If the record is not found, navigate to the "notfound" page
        if (pools is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // Method to delete the Pools record
    private async Task DeletePools()
    {
        using var context = DbFactory.CreateDbContext();
        // Delete the Pools record using SQL query
        await context.Database.ExecuteSqlRawAsync("DELETE FROM Pools WHERE ID = @p0", pools!.ID);
        // Navigate back to the list of pools
        NavigationManager.NavigateTo("/pools");
    }
}
