@page "/playercards"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Tournitrack.Data.Models
@using Tournitrack.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Tournitrack.Data.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="playercards/create">Create New</a> <!-- Link to create a new PlayerCards entry -->
</p>

<!-- QuickGrid to display PlayerCards entries -->
<QuickGrid Class="table" Items="playerCardsList.AsQueryable()">
    <PropertyColumn Property="playercards => playercards.PlayerID" />
    <PropertyColumn Property="playercards => playercards.MatchID" />
    <PropertyColumn Property="playercards => playercards.MatchMinute" />
    <PropertyColumn Property="playercards => playercards.CardType" />

    <TemplateColumn Context="playercards">
        <a href="@($"playercards/edit?id={playercards.ID}")">Edit</a> |
        <a href="@($"playercards/details?id={playercards.ID}")">Details</a> |
        <a href="@($"playercards/delete?id={playercards.ID}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!; // Database context
    private List<PlayerCards> playerCardsList = new(); // List to store PlayerCards entries

    // Method to initialize the component and load PlayerCards entries
    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        // SQL query to get all PlayerCards entries
        string sql = "SELECT * FROM PlayerCards";
        playerCardsList = await context.PlayerCards.FromSqlRaw(sql).ToListAsync();
    }

    // Method to dispose the database context
    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}